# Daily database backup at 03:30 (keeps the latest 30 copies in /opt/stock-ledger/data/backups)
30 3 * * * stockledger /usr/bin/python3 /opt/stock-ledger/app.py backup >/dev/null 2>&1
# Check every outside data source at 06:15, after the US close (result in data/sources.json, shown under 系统状态)
15 6 * * * stockledger /usr/bin/python3 /opt/stock-ledger/app.py check-sources >/dev/null 2>&1
